APP_NAME="IFS Nigeria LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dhnconsulting.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=dhnconsul7_lms
DB_USERNAME=dhnconsul7_lmsuser
DB_PASSWORD=your_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.dhnconsulting.org

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.dhnconsulting.org
MAIL_PORT=587
MAIL_USERNAME=noreply@dhnconsulting.org
MAIL_PASSWORD=your_email_password
MAIL_FROM_ADDRESS="noreply@dhnconsulting.org"
MAIL_FROM_NAME="IFS Nigeria LMS"

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=https://dhnconsulting.org

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
